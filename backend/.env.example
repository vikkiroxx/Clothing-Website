DATABASE_URL="postgresql://postgres:password@localhost:5432/clothing_store?schema=public"
JWT_SECRET="replace-with-a-long-random-secret"
PORT=5000
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Public URLs this server uses to build redirect/webhook URLs for payment
# providers. BACKEND_PUBLIC_URL must be an https:// URL once
# CASHFREE_ENVIRONMENT=PRODUCTION (Cashfree requires HTTPS for notify_url).
FRONTEND_URL="http://localhost:3000"
BACKEND_PUBLIC_URL="http://localhost:5000"

# Payment gateway selection — see backend/PAYMENTS.md. Currently supported: cashfree
PAYMENT_PROVIDER="cashfree"

# Cashfree (see https://merchant.cashfree.com for sandbox/live keys)
CASHFREE_ENVIRONMENT="SANDBOX"
CASHFREE_CLIENT_ID="your-cashfree-client-id"
CASHFREE_CLIENT_SECRET="your-cashfree-client-secret"
# Dated API version string, format YYYY-MM-DD. Optional — defaults to 2026-01-01.
CASHFREE_API_VERSION="2026-01-01"

# SMTP — used to send signup OTP emails. If SMTP_HOST is left unset, emails
# are logged to the console instead of sent, so OTP signup works locally
# without real credentials.
#
# Using Resend (https://resend.com) via its SMTP relay — no SDK needed:
#   SMTP_HOST="smtp.resend.com"
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USER="resend"
#   SMTP_PASSWORD="your-resend-api-key"           # starts with re_
#   SMTP_FROM="The Off-Grid <no-reply@yourdomain.com>"  # must be on a domain verified in Resend,
#                                                        # or use "onboarding@resend.dev" for testing
#                                                        # (only delivers to your own Resend account email)
SMTP_HOST="smtp.resend.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="resend"
SMTP_PASSWORD="your-resend-api-key"
SMTP_FROM="The Off-Grid <no-reply@yourdomain.com>"
